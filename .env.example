# Copy this file to .env and fill in your key
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which Claude model to use. Sonnet = better reasoning, Haiku = cheaper/faster.
CLAUDE_MODEL=claude-sonnet-5

# Path to the piper binary (installed via `pip install piper-tts` into venv/bin)
PIPER_BIN=piper

# Path to the piper voice model you download (see README)
PIPER_VOICE=./voices/en_US-lessac-medium.onnx

# Speech rate: 1.0 = normal, lower = faster (e.g. 0.8 = ~20% faster), higher = slower
PIPER_LENGTH_SCALE=1.0

# Optional: path to an Obsidian vault (or any folder) you want Computron to
# read from and use as its working directory. If unset or the path doesn't
# exist, Computron runs from its own project directory instead — no vault
# required to use it.
COMPUTRON_VAULT_PATH=~/Obsidian/The Triforce
