# Copy this file to .env and fill in your key
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which Claude model to use. Sonnet = better reasoning, Haiku = cheaper/faster.
CLAUDE_MODEL=claude-sonnet-5

# Path to the piper binary (installed via `pip install piper-tts` into venv/bin)
PIPER_BIN=piper

# Path to the piper voice model you download (see README)
PIPER_VOICE=./voices/en_US-lessac-medium.onnx

# Speech rate: 1.0 = normal, lower = faster (e.g. 0.8 = ~20% faster), higher = slower
PIPER_LENGTH_SCALE=1.0

# Optional: path to an Obsidian vault (or any folder) you want Computron to
# read from and use as its working directory. If unset or the path doesn't
# exist, Computron runs from its own project directory instead — no vault
# required to use it.
COMPUTRON_VAULT_PATH=~/Obsidian/The Triforce

# Text-to-speech provider: "piper" (local, free — the default) or
# "elevenlabs" (paid API, more natural voice). Falls back to Piper
# automatically if ELEVENLABS_API_KEY is unset, even if this says elevenlabs.
TTS_PROVIDER=piper

# Get this from https://elevenlabs.io/app/settings/api-keys — only needed
# if TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=

# Voice ID from the ElevenLabs voice library (or one of your own cloned
# voices). Defaults to "Rachel" if unset.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# eleven_turbo_v2_5 = low latency (good for a real-time assistant).
# eleven_multilingual_v2 = higher fidelity, noticeably slower.
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Playback speed multiplier: 1.0 = normal. ElevenLabs' valid range is
# roughly 0.7-1.2 — values outside that get rejected by their API.
ELEVENLABS_SPEED=1.0

# Port for the local-only (127.0.0.1) HTTP bridge the menu bar app exposes
# so the companion VS Code extension can talk to Computron. No auth — only
# reachable from this machine.
COMPUTRON_SERVER_PORT=4317

# Auto-Read mode: fenced code blocks at or under this many lines are read
# aloud as-is; longer ones are replaced with a short spoken placeholder.
AUTO_READ_CODE_LINE_LIMIT=3

# Global push-to-talk hotkey for the menu bar app. Must be a name from
# pynput.keyboard.Key, e.g. alt_r, alt_l, cmd_r, ctrl_r. Right Option by
# default: rarely bound to anything else system-wide.
COMPUTRON_HOTKEY_KEY=alt_r

# Second hotkey, same hold-to-talk shape, but attaches a screenshot to that
# turn only ("Ask About Screen"). Left Option by default. Needs the macOS
# Screen Recording permission granted to whatever process runs Computron
# (System Settings -> Privacy & Security -> Screen Recording) — only takes
# effect after that process's parent (e.g. Terminal) relaunches.
COMPUTRON_SCREEN_HOTKEY_KEY=alt_l

# Floating waveform visualizer look — these are only the seed defaults for
# waveform_settings.json, used the first time it's created. After that,
# edit it live via the menu bar's "Waveform Settings" submenu or
# `python waveform_settings.py` — no restart needed. Defaults below match
# the window's original hardcoded appearance.
# One of: bars, line, orb.
COMPUTRON_WAVEFORM_STYLE=bars
COMPUTRON_WAVEFORM_COLOR=FFFFFF
COMPUTRON_WAVEFORM_OPACITY=0.85
COMPUTRON_WAVEFORM_WIDTH=220
COMPUTRON_WAVEFORM_HEIGHT=60
COMPUTRON_WAVEFORM_BARS=9
COMPUTRON_WAVEFORM_BAR_GAP=4.0
# One of: bottom-center, bottom-left, bottom-right, top-center, top-left,
# top-right, center.
COMPUTRON_WAVEFORM_POSITION=bottom-center
# Distance in px from whichever screen edge(s) the position hugs — ignored
# for "center".
COMPUTRON_WAVEFORM_MARGIN=80
