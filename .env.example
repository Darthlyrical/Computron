# Copy this file to .env and fill in your key
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which Claude model to use. Sonnet = better reasoning, Haiku = cheaper/faster.
CLAUDE_MODEL=claude-sonnet-5

# Path to the piper binary (installed via `pip install piper-tts` into venv/bin)
PIPER_BIN=piper

# Path to the piper voice model you download (see README)
PIPER_VOICE=./voices/en_US-lessac-medium.onnx

# Speech rate: 1.0 = normal, lower = faster (e.g. 0.8 = ~20% faster), higher = slower
PIPER_LENGTH_SCALE=1.0

# Optional: path to an Obsidian vault (or any folder) you want Computron to
# read from and use as its working directory. If unset or the path doesn't
# exist, Computron runs from its own project directory instead — no vault
# required to use it.
COMPUTRON_VAULT_PATH=~/Obsidian/The Triforce

# Text-to-speech provider: "piper" (local, free — the default) or
# "elevenlabs" (paid API, more natural voice). Falls back to Piper
# automatically if ELEVENLABS_API_KEY is unset, even if this says elevenlabs.
TTS_PROVIDER=piper

# Get this from https://elevenlabs.io/app/settings/api-keys — only needed
# if TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=

# Voice ID from the ElevenLabs voice library (or one of your own cloned
# voices). Defaults to "Rachel" if unset.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# eleven_turbo_v2_5 = low latency (good for a real-time assistant).
# eleven_multilingual_v2 = higher fidelity, noticeably slower.
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Port for the local-only (127.0.0.1) HTTP bridge the menu bar app exposes
# so the companion VS Code extension can talk to Computron. No auth — only
# reachable from this machine.
COMPUTRON_SERVER_PORT=4317
